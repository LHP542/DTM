{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/DTM.slnx",
                "-c", "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/DTM.slnx",
                "-c", "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/DTM.Tests/DTM.Tests.csproj",
                "-c", "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch", "run",
                "--project", "${workspaceFolder}/DTM/DTM.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": ["clean", "${workspaceFolder}/DTM.slnx"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-win-x64",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish", "${workspaceFolder}/DTM/DTM.csproj",
                "-c", "Release", "-r", "win-x64",
                "--self-contained", "true",
                "-o", "${workspaceFolder}/publish/win-x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-linux-x64",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish", "${workspaceFolder}/DTM/DTM.csproj",
                "-c", "Release", "-r", "linux-x64",
                "--self-contained", "true",
                "-o", "${workspaceFolder}/publish/linux-x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "release (tag + push)",
            "type": "shell",
            "problemMatcher": [],
            "linux":   { "command": "bash '${workspaceFolder}/scripts/release.sh'" },
            "osx":     { "command": "bash '${workspaceFolder}/scripts/release.sh'" },
            "windows": { "command": "pwsh -NoProfile -File '${workspaceFolder}/scripts/release.ps1'" },
            "options": { "cwd": "${workspaceFolder}" }
        },
        {
            "label": "clean-hard",
            "type": "shell",
            "problemMatcher": [],
            "linux":   { "command": "find '${workspaceFolder}' -type d \\( -name bin -o -name obj \\) -prune -exec rm -rf '{}' +" },
            "osx":     { "command": "find '${workspaceFolder}' -type d \\( -name bin -o -name obj \\) -prune -exec rm -rf '{}' +" },
            "windows": {
                "command": "Get-ChildItem -Path '${workspaceFolder}' -Recurse -Directory -Include bin,obj | Remove-Item -Recurse -Force",
                "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } }
            }
        },
        {
            // App ohne Debugger starten - funktioniert auch ohne installierte
            // C#-Extension (umgeht das "coreclr"-Problem auf Code-OSS/Codium).
            // Aufruf: Ctrl+Shift+P -> "Tasks: Run Task" -> "DTM ausfuehren".
            "label": "DTM ausfuehren",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project", "${workspaceFolder}/DTM/DTM.csproj"
            ],
            "options": {
                "env": {
                    "DOTNET_ROOT": "${env:HOME}/.dotnet",
                    "PATH": "${env:HOME}/.dotnet:${env:HOME}/.dotnet/tools:${env:PATH}"
                }
            },
            "presentation": {
                "panel": "dedicated",
                "focus": false,
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            // Oeffnet das aktuelle Info-Logfile mit dem Default-Programm.
            // Pfad orientiert sich am NLog-${basedir}/logs unter bin/Debug/net10.0.
            "label": "Logfile info oeffnen",
            "type": "shell",
            "linux":   { "command": "xdg-open DTM/bin/Debug/net10.0/logs/info.log" },
            "osx":     { "command": "open DTM/bin/Debug/net10.0/logs/info.log" },
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-Command", "Start-Process DTM\\bin\\Debug\\net10.0\\logs\\info.log"]
            },
            "problemMatcher": []
        },
        {
            // Oeffnet das aktuelle Error-Logfile mit dem Default-Programm.
            "label": "Logfile error oeffnen",
            "type": "shell",
            "linux":   { "command": "xdg-open DTM/bin/Debug/net10.0/logs/error.log" },
            "osx":     { "command": "open DTM/bin/Debug/net10.0/logs/error.log" },
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-Command", "Start-Process DTM\\bin\\Debug\\net10.0\\logs\\error.log"]
            },
            "problemMatcher": []
        }
    ]
}
