<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Lars Oste</Authors>
    <RepositoryUrl>https://github.com/LHP542/$(MSBuildProjectName)</RepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ohne diese Zeile ist die .editorconfig zahnlos: die Stilregeln laufen
         nur im Editor und tauchen im Build nirgends auf. Zusammen mit
         TreatWarningsAsErrors werden Stilverstöße zu Compile-Fehlern statt zu
         Fundsachen im Review. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (ungenutzte using-Direktiven) meldet sich ohne die
         XML-Doku-Erzeugung nicht, sondern verlangt sie ausdrücklich
         (Roslyn-Issue 41640). CS1591 muss dann raus, sonst will der Compiler
         auf jedem öffentlichen Member einen Doc-Kommentar. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
