<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework, Nullable, ImplicitUsings, LangVersion, Authors,
         RepositoryUrl, TreatWarningsAsErrors kommen aus Directory.Build.props.
         Version/AssemblyVersion/AssemblyInformationalVersion werden von MinVer
         aus dem juengsten Git-Tag mit Prefix "v" berechnet (z.B. v1.1.0). -->
    <!-- WinExe = GUI-App: Windows oeffnet KEIN Konsolenfenster. Bei Exe
         (Console-App) haengt ein leeres Console-Window an der Exe und
         zeigt NLog-coloredConsole-Ausgaben — bei einer Desktop-App
         unerwuenscht. Unter Linux hat das keinen Effekt. -->
    <OutputType>WinExe</OutputType>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App-Icon fuer die Windows-Exe (Explorer/Taskbar). Fenster-Icon
         zieht ChromeWindow zur Laufzeit aus Assets/dtm.png. -->
    <ApplicationIcon>Assets\dtm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="MinVer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog" />
    <PackageReference Include="System.Data.Odbc" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
    <!-- PowerShell-Backend: in-process Runspace statt Process.Start mit Pipes. -->
    <PackageReference Include="Microsoft.PowerShell.SDK" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DTM.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nlog.config muss neben der Exe liegen (NLog liest ${basedir}/Nlog.config).
         Assets/*.png werden ueber <AvaloniaResource> in die DLL eingebettet
         (avares://DTM/Assets/*), kein zusaetzliches CopyToOutputDirectory noetig.
         release-notes.json wird zur Laufzeit aus dem GitHub-Raw geladen
         (Klemmbrett-Muster), keine lokale Kopie noetig. -->
    <None Update="Nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
