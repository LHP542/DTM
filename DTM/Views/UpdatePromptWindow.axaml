<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:DTM.Views"
        xmlns:sys="using:System"
        xmlns:c="using:DTM.Views.Controls"
        x:Class="DTM.Views.UpdatePromptWindow"
        Title="Update verfügbar"
        Width="560" Height="540"
        MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Titelleiste -->
        <c:TitleBar Grid.Row="0" Title="Update verfügbar" />

        <!-- HorizontalScrollBarVisibility="Disabled" ist hier kein Detail:
             ohne das darf der Inhalt beliebig breit messen, und die
             TextWrapping="Wrap" der Texte greift nie — der MSSQL-Banner wurde
             dadurch rechts abgeschnitten statt umzubrechen. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <!-- Die Ränder stehen hier als Margin am inneren Container und
                 NICHT als Padding am ScrollViewer. Der Unterschied ist nicht
                 kosmetisch: mit Padding messen die TextBlocks weiter gegen die
                 volle Breite, der Rollbalken legt sich darüber, und von jeder
                 Zeile fehlen die letzten ein bis zwei Zeichen ("DTM brauch"
                 statt "DTM braucht"). Das ist genau so im Update-Dialog von
                 v2.4.0 gelandet.
                 Rechts mehr als links, damit der Balken nicht auf dem Text
                 sitzt. -->
            <StackPanel Spacing="14" Margin="20,16,30,16">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />

                <!-- Banner: MSSQL-Modul geändert (manueller Server-Eingriff nötig). -->
                <Border x:Name="MssqlBanner" IsVisible="False"
                        Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="⚠ MSSQL-Modul wurde geändert"
                                   FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerTextSoftBrush}" FontSize="12"
                                   Text="Das MSSQL-Modul liegt auf jedem SQL-Server in einem User-Profil. Damit der Update wirksam wird, muss auf jedem Server einmalig eine PowerShell-Sitzung geöffnet werden — das Profil-Skript zieht das neue Modul dann automatisch nach. Bis dahin verweigert FOC-SQL die MSSQL-Aufrufe mit einer VERSION_MISMATCH-Meldung." />
                    </StackPanel>
                </Border>

                <!-- Banner: FOC-SQL geändert (DTM zieht es automatisch). -->
                <Border x:Name="FocSqlBanner" IsVisible="False"
                        Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ℹ FOC-SQL-Modul wurde aktualisiert"
                                   FontWeight="SemiBold" Foreground="{DynamicResource OkTextBrush}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource OkTextSoftBrush}" FontSize="12"
                                   Text="DTM zieht das neue FOC-SQL-Modul beim nächsten Start automatisch von der Samba-Quelle. Kein manueller Eingriff nötig." />
                    </StackPanel>
                </Border>

                <!-- Versionshistorie -->
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="v:NoteRow">
                            <Border Background="{DynamicResource KrosteCardBrush}"
                                    BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding DateLabel}"
                                                   Foreground="{DynamicResource KrosteMutedTextBrush}"
                                                   FontSize="11" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Bullets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="sys:String">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                                    <TextBlock Grid.Column="0" Text="• " />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                <!-- MinWidth statt Width: eine feste Breite schneidet ab, was
                     nicht hineinpasst, ohne Fehler und ohne Warnung — aus
                     "Später (30 min)" wurde in v2.4.0 "Später (30 mir".
                     MinWidth hält die Knöpfe optisch gleich breit und lässt
                     längere Beschriftungen trotzdem wachsen. -->
                <Button x:Name="SkipButton" Content="Überspringen"  Click="OnSkip"  MinWidth="120" />
                <Button Content="Später (30 min)"                   Click="OnLater" MinWidth="120" />
                <Button Content="Jetzt aktualisieren"               Click="OnApply" MinWidth="160" Classes="accent" />
            </WrapPanel>
        </Border>
    </Grid>

</Window>
