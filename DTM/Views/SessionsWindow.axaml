<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DTM.ViewModels"
        mc:Ignorable="d"
        xmlns:c="using:DTM.Views.Controls"
        x:Class="DTM.Views.SessionsWindow"
        x:DataType="vm:SessionsViewModel"
        Title="Sessions"
        Width="800" Height="490"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Titelleiste -->
        <c:TitleBar Grid.Row="0" Title="Sessions" />

        <!-- Tabelle in einer Karte mit Rand — wie in allen anderen Dialogen.
             Vorher hing das DataGrid ohne Margin direkt im Grid und klebte
             links und rechts an der Fensterkante; als einziges Fenster im
             Projekt. -->
        <Border Grid.Row="1" Margin="20,14,20,14"
                Background="{DynamicResource KrosteCardBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Sessions}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="Maschine" Binding="{Binding Maschine}" Width="*" />
                    <DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="*" />
                    <DataGridTextColumn Header="Status"   Binding="{Binding Status}"   Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer: Aktionen -->
        <Border Grid.Row="2" Background="{DynamicResource KrosteCardBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource KrosteMutedTextBrush}" FontSize="12">
                    <Run Text="Datenbank: " />
                    <Run Text="{Binding DatabaseDisplayName}" FontWeight="SemiBold"
                         Foreground="{DynamicResource KrosteTextBrush}" />
                </TextBlock>
                <Button x:Name="CloseSessionsButton" Grid.Column="1" Click="OnCloseAllSessions"
                        IsEnabled="{Binding CanCloseSessions}"
                        Classes="action danger"
                        ToolTip.Tip="Alle aktiven Sessions zu dieser Datenbank per KILL beenden">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="glyph" Text="&#x2715;" />
                        <TextBlock Text="Alle Sessions beenden" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>

</Window>
