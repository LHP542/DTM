<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DTM.ViewModels"
        mc:Ignorable="d"
        x:Class="DTM.Views.EditConnectionWindow"
        x:DataType="vm:EditConnectionViewModel"
        Title="Verbindung bearbeiten"
        Width="500" Height="640"
        MinWidth="460" MinHeight="540"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*">

        <!-- Titelleiste -->
        <Border Grid.Row="0" Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto" Height="36">
                <TextBlock Grid.Column="0"
                           Text="Verbindung bearbeiten" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource KrosteMutedTextBrush}"
                           VerticalAlignment="Center" Margin="14,0"
                           IsHitTestVisible="False" />
                <Button Grid.Column="1" Classes="chrome close"
                        Click="OnTitleClose" Content="&#x2715;" />
            </Grid>
        </Border>

        <!-- Inhalt -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="20,16">

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Typ" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <ComboBox  Grid.Row="0" Grid.Column="1"
                                   ItemsSource="{Binding ServerTypes}"
                                   SelectedItem="{Binding SelectedServerType, Mode=TwoWay}"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Server, Mode=TwoWay}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Benutzer" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding User, Mode=TwoWay}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Passwort" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}"
                                   PasswordChar="●" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Datenbank" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding Database, Mode=TwoWay}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="ConnectionString" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,8,0" />
                        <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding ConnectionString, Mode=TwoWay}"
                                   ToolTip.Tip="Optionaler ODBC-ConnectionString. Wenn gesetzt, werden Server/User/Passwort ignoriert." />
                    </Grid>

                    <!-- Phase 10.2: Backend-Wahl (nur MSSQL, Oracle nutzt weiter FOC-SQL/SSH) -->
                    <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12"
                            IsVisible="{Binding IsMssql}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backend" FontWeight="SemiBold" />
                            <TextBlock Text="FocSql = Standard-Setup: Actions laufen über das FOC-SQL-Modul via WinRM zum Server (inkl. Mail-Versand, Cluster-Health, Samba-Copy). OdbcDirect = Actions gehen direkt über die ODBC/1433-Verbindung (Backup, Restore, Snapshot, Wartung). Nutzen: DMZ-Server ohne WinRM. Copy-Database-ToSamba und Sync-Database-ToTest sind bei OdbcDirect nicht verfügbar."
                                       Foreground="{DynamicResource KrosteMutedTextBrush}"
                                       FontSize="12" TextWrapping="Wrap" />

                            <Grid RowDefinitions="Auto" ColumnDefinitions="140,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ausführungspfad"
                                           VerticalAlignment="Center" Margin="0,4,8,0" />
                                <ComboBox  Grid.Row="0" Grid.Column="1"
                                           ItemsSource="{Binding Backends}"
                                           SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Phase 9.3: PS-Remoting-Credentials (nur MSSQL) -->
                    <Border BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12"
                            IsVisible="{Binding IsMssql}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PowerShell-Remoting-Credentials (optional)"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Leer lassen = FOC-SQL nimmt seine globale credential.xml aus dem User-Profil. Nur ausfüllen, wenn dieser Server abweichende Windows-Credentials braucht (z. B. DMZ mit lokaler Domain). Bei Backend = OdbcDirect wird das Feld ignoriert."
                                       Foreground="{DynamicResource KrosteMutedTextBrush}"
                                       FontSize="12" TextWrapping="Wrap" />

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="140,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Remote-Benutzer"
                                           VerticalAlignment="Center" Margin="0,4,8,8" />
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding RemoteUser, Mode=TwoWay}"
                                           PlaceholderText="z. B. DMZ\svc-dtm"
                                           Margin="0,4,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Remote-Passwort"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding RemotePassword, Mode=TwoWay}"
                                           PasswordChar="●" Margin="0,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,16,0,0">
                <Button Content="Abbrechen" Click="OnCancel" Width="100" />
                <Button Content="Speichern" Click="OnSave" Width="100" IsDefault="True" Classes="accent" />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
