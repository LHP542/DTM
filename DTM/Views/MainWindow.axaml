<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DTM.ViewModels"
        xmlns:nodes="using:DTM.ViewModels.TreeNodes"
        xmlns:ctrl="using:DTM.Views.Controls"
        mc:Ignorable="d"
        x:Class="DTM.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Datenbank-Manager"
        Width="1280" Height="780"
        MinWidth="980" MinHeight="620"
        Background="{DynamicResource KrosteBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== Titelleiste ===== -->
        <ctrl:TitleBar Grid.Row="0" Title="Datenbank-Manager"
                    Glyph="&#x25A0;" GlyphBrush="{DynamicResource KrosteGoldBrush}"
                    ShowMinimize="True" ShowMaximize="True">
            <!-- Fensterspezifischer Chrome-Button; Min/Max/Close und der
                 Glyph-Wechsel beim Maximieren kommen aus dem Control. -->
            <ctrl:TitleBar.ExtraContent>
                <Button Classes="chrome" Click="OnAbout"
                        Content="&#x2139;" ToolTip.Tip="Über Datenbank-Manager" />
            </ctrl:TitleBar.ExtraContent>
        </ctrl:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">

            <!-- ===== Seitenleiste: DB-Baum ===== -->
            <Border Grid.Column="0" Background="{DynamicResource KrosteCardBrush}"
                    BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,16,18,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x25A0;" FontSize="16"
                                           Foreground="{DynamicResource KrosteGoldBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Datenbanken" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KrosteTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="action"
                                    Command="{Binding ManageConnectionsCommand}"
                                    ToolTip.Tip="Verbindungen verwalten"
                                    Width="38" MinWidth="0" Padding="0">
                                <!-- FontSize passend zum 38px-Button. Stand hier
                                     lange auf 60 — das Zahnrad wurde dadurch
                                     abgeschnitten und sah aus wie ein leeres
                                     graues Kaestchen. -->
                                <TextBlock Classes="glyph" Text="&#x2699;" Margin="0"
                                           FontSize="16" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                    <TreeView Background="Transparent"
                              Padding="8,0,8,8"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              ItemTemplate="{StaticResource NodeTemplate}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="nodes:NodeViewModelBase">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- ===== Hauptbereich ===== -->
            <Grid Grid.Column="1" Margin="20,18,20,12" RowDefinitions="Auto,Auto,*">

                <!-- Info-Karte -->
                <Border Grid.Row="0" Background="{DynamicResource KrosteCardBrush}"
                        BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="22,18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding DbName}" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource KrosteTextBrush}" />
                                <Border VerticalAlignment="Center" CornerRadius="6"
                                        Background="{DynamicResource KrosteAccentSoftBrush}" Padding="9,3">
                                    <TextBlock Text="{Binding DbStatus}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource KrosteGoldBrush}" />
                                </Border>
                                <!-- Cluster-Health: MSSQL-only, read-only.
                                     Ruft Get-ClusterHealthStatus im pwsh-Tab auf
                                     (Always-On / Failover-Cluster-Status). -->
                                <Button VerticalAlignment="Center"
                                        Command="{Binding CheckClusterHealthCommand}"
                                        IsVisible="{Binding ClusterHealthVisible}"
                                        ToolTip.Tip="Cluster-Health prüfen (Get-ClusterHealthStatus)"
                                        Padding="10,4" Height="26" MinWidth="0"
                                        Foreground="{DynamicResource KrosteMutedTextBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="&#x29C8;" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource KrosteGoldBrush}" />
                                        <TextBlock Text="Cluster-Health" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="infoLabel" Text="Host" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="infoValue" Text="{Binding DbHost}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="infoLabel" Text="Comp. Level" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="infoValue" Text="{Binding DbVersion}" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="infoLabel" Text="Größe" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="infoValue" Text="{Binding DbSize}" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="infoLabel" Text="{Binding RecoveryLabel}" Margin="0,4,0,0" />
                                <!-- Read-only TextBlock fuer Oracle (oder solange RecoveryModeVisible=false) -->
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="infoValue"
                                           Text="{Binding RecoveryOrArchiveMode}" Margin="0,4,0,0"
                                           IsVisible="{Binding !RecoveryModeVisible}" />
                                <!-- Dropdown fuer MSSQL: Recovery-Mode FULL/SIMPLE/BULK_LOGGED setzen -->
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding RecoveryModeOptions}"
                                          SelectedItem="{Binding RecoveryModeSelected, Mode=TwoWay}"
                                          IsVisible="{Binding RecoveryModeVisible}"
                                          MinWidth="140" Padding="8,2" Margin="0,4,0,0"
                                          ToolTip.Tip="Recovery-Modus aendern (Set-DbRecoveryMode). Wechsel zu SIMPLE bricht die Log-Chain!" />
                            </Grid>
                        </StackPanel>

                        <!-- Aktive Sessions als kleine Kachel -->
                        <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10"
                                Background="{DynamicResource KrosteSurfaceBrush}"
                                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                                Padding="16,12">
                            <Button Command="{Binding ShowSessionsCommand}" Classes="ghost"
                                    Padding="0"
                                    Cursor="Hand">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Aktive Sessions" FontSize="11"
                                               Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                    <TextBlock Text="{Binding ActiveSessionsCount}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource KrosteGoldBrush}" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- Aktions-Bereich -->
                <Border Grid.Row="1" Margin="0,14,0,0" Padding="2">
                    <StackPanel Spacing="14">
                        <!-- Gruppe: Sicherung -->
                        <StackPanel>
                            <TextBlock Classes="section-label" Text="SICHERUNG" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action primary" Command="{Binding BackupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2913;" />
                                        <TextBlock Text="{Binding BackupButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding CloneCommand}"
                                        IsVisible="{Binding SyncToTestVisible}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x29C9;" />
                                        <TextBlock Text="Clone" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding DbToSambaCommand}"
                                        IsVisible="{Binding CopyToSambaVisible}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2197;" />
                                        <TextBlock Text="DB → Samba" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gruppe: Snapshots -->
                        <StackPanel>
                            <TextBlock Classes="section-label" Text="SNAPSHOTS" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action" Command="{Binding SnapshotCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x25C9;" />
                                        <TextBlock Text="Snapshot" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding RestoreSnapshotCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x21BA;" />
                                        <TextBlock Text="Restore" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action danger" Command="{Binding RemoveSnapshotCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2715;" />
                                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gruppe: OLVM (Oracle-only, Phase 11) -->
                        <StackPanel IsVisible="{Binding OlvmVisible}">
                            <TextBlock Classes="section-label" Text="OLVM" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action danger" Command="{Binding OlvmSnapshotCommand}"
                                        ToolTip.Tip="VM-Snapshot per Ansible auf DBMANAGER01 — DB + VM werden heruntergefahren, Dauer mehrere Minuten">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x25C9;" />
                                        <TextBlock Text="VM-Snapshot" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding OlvmRestoreSnapshotCommand}"
                                        ToolTip.Tip="OLVM-Snapshots anzeigen und Restore ausführen (Playbook Phase 11.4)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x21BA;" />
                                        <TextBlock Text="VM-Restore" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action danger" Command="{Binding OlvmRemoveSnapshotCommand}"
                                        ToolTip.Tip="OLVM-Snapshots anzeigen und löschen (Playbook Phase 11.5)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2715;" />
                                        <TextBlock Text="VM-Remove" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gruppe: Backups (MSSQL-only) -->
                        <StackPanel IsVisible="{Binding BackupBrowserVisible}">
                            <TextBlock Classes="section-label" Text="BACKUPS" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action" Command="{Binding OpenBackupBrowserCommand}"
                                        ToolTip.Tip="Vorhandene .bak-Dateien anzeigen und Restore ausfuehren">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x1F4C2;" />
                                        <TextBlock Text="Browser" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gruppe: Wartung (MSSQL-only) -->
                        <StackPanel IsVisible="{Binding MaintenanceVisible}">
                            <TextBlock Classes="section-label" Text="WARTUNG" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action" Command="{Binding RunCheckDbCommand}"
                                        ToolTip.Tip="DBCC CHECKDB — Integritaetspruefung der Datenbank">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2714;" />
                                        <TextBlock Text="CHECKDB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding RunIndexRebuildCommand}"
                                        ToolTip.Tip="ALTER INDEX ALL ... REBUILD + UPDATE STATISTICS">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x21BB;" />
                                        <TextBlock Text="Index Rebuild" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action danger" Command="{Binding RunShrinkLogCommand}"
                                        ToolTip.Tip="DBCC SHRINKFILE auf das Logfile (bricht Log-Chain!)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x21F2;" />
                                        <TextBlock Text="Shrink Log" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding OpenDbConfigurationCommand}"
                                        ToolTip.Tip="DB-Konfiguration: Query-Store, Page-Verify, Compatibility-Reset">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x2699;" />
                                        <TextBlock Text="Konfiguration" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Gruppe: Archive-Log -->
                        <StackPanel>
                            <TextBlock Classes="section-label" Text="ARCHIVE-LOG" />
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="action" Command="{Binding ArchiveLogOnCommand}"
                                        IsEnabled="{Binding ArchiveLogOnEnabled}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x25B6;" />
                                        <TextBlock Text="Log An" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="action" Command="{Binding ArchiveLogOffCommand}"
                                        IsEnabled="{Binding ArchiveLogOffEnabled}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="glyph" Text="&#x25A0;" />
                                        <TextBlock Text="Log Aus" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Konsole -->
                <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource ConsoleBgBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource KrosteCardBrush}"
                                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="&#x2328;" FontSize="14"
                                           Foreground="{DynamicResource KrosteGoldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="PowerShell" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KrosteMutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ctrl:ConsoleControl InitialScript="{Binding ShellInitialCommand}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Statusleiste ===== -->
        <Border Grid.Row="2" Padding="20,7" Background="{DynamicResource KrosteCardBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource KrosteSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusBar}" FontSize="12"
                           Foreground="{DynamicResource KrosteMutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
