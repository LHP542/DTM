<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DTM.ViewModels"
        xmlns:cfg="using:DTM.Config"
        xmlns:c="using:DTM.Views.Controls"
        mc:Ignorable="d"
        x:Class="DTM.Views.ConnectionManagerWindow"
        x:DataType="vm:ConnectionManagerViewModel"
        Title="Verbindungen verwalten"
        Width="820" Height="720"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!-- Breite 820 statt 700: bei 700 wurden die Formular-Labels
         ("Samba-Quelle (Global)", "Modulpfad (Override)") und der
         Hinweistext unter den Buttons rechts abgeschnitten. -->
    <Grid RowDefinitions="Auto,*">

        <c:TitleBar Grid.Row="0" Title="Verbindungen verwalten" />

        <!-- Inhalt -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto,Auto" Margin="16">

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Connections}"
                      SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Typ"             Binding="{Binding Key}"              Width="Auto" />
                    <DataGridTextColumn Header="Server"          Binding="{Binding Server}"            Width="2*" />
                    <DataGridTextColumn Header="Benutzer"        Binding="{Binding User}"              Width="Auto" />
                    <DataGridTextColumn Header="Datenbank"       Binding="{Binding Database}"          Width="Auto" />
                    <DataGridTextColumn Header="ConnectionString" Binding="{Binding ConnectionString}" Width="*" MinWidth="150" />
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,10,0,6">
                <Button x:Name="AddButton" Content="Neu"        Click="OnAdd"    MinWidth="110" />
                <Button Content="Bearbeiten" Click="OnEdit"   MinWidth="110" />
                <Button Content="Löschen"    Click="OnDelete" MinWidth="110" Classes="danger" />
            </WrapPanel>

            <TextBlock Grid.Row="2" FontSize="11" Opacity="0.6"
                       Text="Verbindungen werden in %APPDATA%\DTM\connections.json verschlüsselt gespeichert. Änderungen werden beim nächsten Start übernommen." />

            <!-- Separator -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                    Margin="0,12,0,0" Padding="0,12,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="170,*">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,10" Text="FOC-SQL Modul" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Samba-Quelle (Glob)"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="1" Grid.Column="1"
                               Text="{Binding SambaSource, Mode=TwoWay}"
                               PlaceholderText="leer = eingebauter Default"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Modulpfad (Override)"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="2" Grid.Column="1"
                               Text="{Binding ModulePath, Mode=TwoWay}"
                               PlaceholderText="leer = Samba-Logik aktiv"
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Update-Quelle"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="3" Grid.Column="1"
                               Text="{Binding UpdateChannel, Mode=TwoWay}"
                               PlaceholderText="{Binding UpdateChannelPlaceholder}"
                               ToolTip.Tip="Ordner im Netz (UNC-Pfad) oder https://… für GitHub. Wirkt beim nächsten Start."
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="MariaDB-Werkzeuge"
                               FontWeight="SemiBold" Margin="0,10,8,6" Grid.ColumnSpan="2" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="mariadb-dump"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="5" Grid.Column="1"
                               Text="{Binding MariaDbDumpPath, Mode=TwoWay}"
                               PlaceholderText="leer = im PATH suchen (mariadb-dump, mysqldump)"
                               ToolTip.Tip="Voller Pfad zum Dump-Werkzeug. MariaDB kennt kein BACKUP DATABASE — Sicherungen laufen über dieses Programm."
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="mariadb (Client)"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="6" Grid.Column="1"
                               Text="{Binding MariaDbClientPath, Mode=TwoWay}"
                               PlaceholderText="leer = im PATH suchen (mariadb, mysql)"
                               ToolTip.Tip="Voller Pfad zum Client — wird zum Zurückspielen eines Dumps gebraucht."
                               Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Backup-Ziel"
                               VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBox   Grid.Row="7" Grid.Column="1"
                               Text="{Binding MariaDbBackupRoot, Mode=TwoWay}"
                               PlaceholderText="leer = %USERPROFILE%\DTM-Backups\MariaDB"
                               ToolTip.Tip="Wurzelverzeichnis für Dumps. Darunter legt DTM je Server und Datenbank einen Unterordner an."
                               Margin="0,0,0,6" />

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <TextBlock FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                   Text="Gespeichert in %APPDATA%\DTM\settings.json — beim nächsten Start aktiv." />
                        <Button Content="Speichern" Click="OnSaveFocSql" MinWidth="100" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
