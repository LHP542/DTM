<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:DTM.Views.Controls"
        x:Class="DTM.Views.FatalErrorWindow"
        Title="Unbehandelte Ausnahme"
        Width="640" Height="480"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Titelleiste -->
        <c:TitleBar Grid.Row="0" Title="Unbehandelte Ausnahme"
                    Glyph="&#x26A0;" GlyphBrush="{DynamicResource KrosteDangerBrush}" />

        <!-- Inhalt -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="20,16,20,16">

            <!-- Kopfbereich: Quelle + Exception-Typ -->
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock x:Name="SourceText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource KrosteDangerBrush}" />
                <TextBlock x:Name="ExceptionTypeText" FontSize="12"
                           Foreground="{DynamicResource KrosteMutedTextBrush}"
                           FontFamily="Cascadia Mono, Consolas, Menlo, Monospace" />
            </StackPanel>

            <!-- Trennlinie -->
            <Border Grid.Row="1" Height="1"
                    Background="{DynamicResource KrosteBorderBrush}" Margin="0,12" />

            <!-- Message + Stacktrace -->
            <Border Grid.Row="2" Background="{DynamicResource KrosteCardBrush}"
                    BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource KrosteTextBrush}"
                                   FontSize="13" />
                        <Border Height="1" Background="{DynamicResource KrosteBorderBrush}" />
                        <TextBlock x:Name="StackTraceText" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource KrosteMutedTextBrush}"
                                   FontSize="11"
                                   FontFamily="Cascadia Mono, Consolas, Menlo, Monospace" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer-Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Content="Log-Ordner &#xF6;ffnen" Click="OnOpenLogs"
                        MinWidth="140" />
                <Button x:Name="CloseButton" Content="Schlie&#xDF;en" Click="OnClose"
                        MinWidth="100" IsDefault="True" Classes="action primary" />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
