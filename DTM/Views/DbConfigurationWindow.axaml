<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DTM.ViewModels"
        xmlns:c="using:DTM.Views.Controls"
        x:Class="DTM.Views.DbConfigurationWindow"
        x:DataType="vm:DbConfigurationViewModel"
        Title="DB-Konfiguration"
        Width="540" Height="500"
        MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- Titelleiste -->
        <c:TitleBar Grid.Row="0" Title="DB-Konfiguration"
                    Glyph="&#x2699;" GlyphBrush="{DynamicResource KrosteGoldBrush}" />

        <!-- Inhalt -->
        <!-- Rechts mehr Rand als links: Avalonia schiebt den Inhalt nicht zur
             Seite, wenn der Rollbalken erscheint, sondern zeichnet ihn darüber.
             Ohne den Zuschlag säße er auf den Eingabefeldern. Fällt im Entwurf
             nicht auf, weil der Balken erst bei zu hohem Inhalt auftaucht. -->
        <ScrollViewer Grid.Row="1" Padding="20,16,30,16"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">

                <!-- Header: DB-Name -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Classes="infoLabel" Text="Datenbank" />
                    <TextBlock Grid.Column="1" Classes="infoValue"
                               Text="{Binding DatabaseName}" FontWeight="Bold" />
                </Grid>

                <!-- Query-Store -->
                <Border Background="{DynamicResource KrosteCardBrush}"
                        BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-label" Text="QUERY-STORE" Margin="0" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Sammelt Query-Pläne und Laufzeit-Statistiken in der DB selbst (sys.query_store_*). Nützlich für Performance-Analysen." />
                        <Grid ColumnDefinitions="*,Auto">
                            <CheckBox Grid.Column="0" Content="Query-Store aktiviert"
                                      IsChecked="{Binding QueryStoreOn, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Anwenden" Click="OnApplyQueryStore"
                                    Classes="action" MinWidth="100" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Page-Verify -->
                <Border Background="{DynamicResource KrosteCardBrush}"
                        BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-label" Text="PAGE-VERIFY" Margin="0" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Prüfmechanismus für Datenseiten. CHECKSUM ist Standard und empfohlen; NONE deaktiviert die Prüfung komplett (nur für alte DBs)." />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PageVerifyOptions}"
                                      SelectedItem="{Binding PageVerifySelected, Mode=TwoWay}"
                                      MinWidth="200" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Anwenden" Click="OnApplyPageVerify"
                                    Classes="action" MinWidth="100" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Compatibility -->
                <Border Background="{DynamicResource KrosteCardBrush}"
                        BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="section-label" Text="COMPATIBILITY-LEVEL" Margin="0" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource KrosteMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Reset auf den MASTER-DB-Default des SQL-Servers (z. B. 150 = SQL 2019, 160 = SQL 2022). Änderung kann das Query-Verhalten beeinflussen." />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource KrosteTextBrush}">
                                <Run Text="Aktuell:" Foreground="{DynamicResource KrosteMutedTextBrush}" />
                                <Run Text="{Binding CompatibilityLevel}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Grid.Column="1" Content="Auf MASTER zurücksetzen"
                                    Click="OnResetCompatibility"
                                    Classes="action danger" MinWidth="180" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="CloseButton" Content="Schließen" Click="OnCancel" MinWidth="100" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
