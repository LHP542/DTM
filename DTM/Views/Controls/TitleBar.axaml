<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DTM.Views.Controls.TitleBar"
             Height="36"
             Background="{DynamicResource KrosteTitleBarBrush}">
    <!-- Wiederverwendbare Titelleiste für alle DTM-Fenster: Titel links,
         optional Min/Max, immer Schließen rechts. Seit dem Rollout in Phase 12
         gibt es im Projekt keine handgebaute Titelleiste mehr — fensterspezifische
         Knöpfe kommen über ExtraContent dazu.

         Das Zeiger-Handling läuft über das Code-Behind (nicht über die
         ElementRole-Rollen von Avalonia 12), weil DTM den etablierten
         IsHitTestVisible-Weg nutzt und der plattformübergreifend stabil ist.
         Der x:Name der Border ist dabei nicht schmückend: LandedOnInteractiveChild
         braucht sie als Abbruchpunkt beim Hochlaufen des Visual-Trees. -->
    <Border x:Name="Bar"
            BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="OnBarPointerPressed"
            DoubleTapped="OnBarDoubleTapped">
        <Grid ColumnDefinitions="*,Auto">
            <!-- Glyph + Text als eine Einheit: die meisten Dialoge führen ein
                 kleines Piktogramm vor dem Titel (Warnung, Zahnrad, Restore-
                 Pfeil). Ohne gesetztes Glyph bleibt der TextBlock unsichtbar
                 und das Layout entspricht exakt der reinen Text-Variante. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="14,0"
                        IsHitTestVisible="False">
                <TextBlock x:Name="GlyphText" FontSize="13"
                           VerticalAlignment="Center" IsVisible="False" />
                <TextBlock x:Name="TitleText"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource KrosteMutedTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <!-- Platz für fensterspezifische Chrome-Buttons links von
                     Min/Max/Close (MainWindow hängt hier sein "Über"-i ein). -->
                <ContentControl x:Name="ExtraSlot" />
                <Button x:Name="MinButton" Classes="chrome"
                        Click="OnMinClick" Content="&#x2013;"
                        IsVisible="False" />
                <Button x:Name="MaxButton" Classes="chrome"
                        Click="OnMaxClick" Content="&#x2750;"
                        IsVisible="False" />
                <Button x:Name="CloseButton" Classes="chrome close"
                        Click="OnCloseClick" Content="&#x2715;" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
