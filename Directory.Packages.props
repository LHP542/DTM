<Project>
  <!--
    Central Package Management (CPM): alle NuGet-Paketversionen werden zentral
    hier gepflegt. Die .csproj enthalten nur noch <PackageReference> OHNE
    Version-Attribut. Doku: https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitives Pinning: PackageVersion-Eintraege wirken auch fuer
         transitive Dependencies (auch wenn kein PackageReference direkt
         darauf verweist). Ermoeglicht CVE-Fixes fuer indirekte Abhaengigkeiten
         (siehe System.Security.Cryptography.Xml unten). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.11" />
    <!-- Transitive Pin: Avalonia 12.1 zieht System.Security.Cryptography.Xml
         10.0.6 mit, das mehrere hoch-Sev-CVEs hat (NU1903). Auf 10.0.10 heben. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="NLog" Version="6.2.0" />
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- xunit.v3 (statt xunit 2.x deprecated). Runner ist derselbe. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- FluentAssertions: ab v8 Xceed-Lizenz (kommerzielle Nutzung kostenpflichtig).
         v7 bleibt dauerhaft Apache 2.0 — Range verhindert versehentliches Upgrade.
         Zusätzlich abgesichert per Dependabot-Ignore-Regel (.github/dependabot.yml). -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>
</Project>
